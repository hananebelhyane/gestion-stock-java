<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<AnchorPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gestiondestock.controller.EditStockController"
            prefWidth="400" prefHeight="300">

    <VBox spacing="15" alignment="TOP_CENTER" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" style="-fx-padding: 20;">

        <Label text="Éditer le Stock" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <!-- Sélection produit -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Produit :" prefWidth="120"/>
            <ComboBox fx:id="produitComboBox" prefWidth="220"/>
        </HBox>

        <!-- Quantité disponible -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Quantité Disponible :" prefWidth="120"/>
            <TextField fx:id="quantiteField" prefWidth="220"/>
        </HBox>

        <!-- Seuil d'alerte -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Seuil d'Alerte :" prefWidth="120"/>
            <TextField fx:id="seuilField" prefWidth="220"/>
        </HBox>

        <!-- Boutons -->
        <HBox spacing="20" alignment="CENTER">
            <Button text="Enregistrer" fx:id="saveButton"/>
            <Button text="Annuler" fx:id="cancelButton"/>
        </HBox>

    </VBox>

</AnchorPane>
