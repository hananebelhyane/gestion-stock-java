<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gestiondestock.controller.MagasinierDashboardController"
            fx:id="root"
            style="-fx-background-color: #EAEEF4;">
  
  <!-- SIDEBAR (même style que admin) -->
  <left>
    <VBox spacing="20" style="-fx-background-color: white; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
          prefWidth="250" minWidth="200" fx:id="sidebar">
      <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
      
      <!-- Logo / Titre (même que admin avec ImageView) -->
      <HBox spacing="8" alignment="CENTER_LEFT">
        <ImageView fx:id="logoImage" fitWidth="120" preserveRatio="true" smooth="true" />
      </HBox>
      
      <Separator style="-fx-background-color: #e5e7eb;" />
      
      <!-- Titre du Dashboard -->
      <VBox spacing="4">
        <Label text="Dashboard Magasinier" 
               style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 13px;" />
      </VBox>
      
      <!-- Boutons de navigation (même style que admin) -->
      <VBox spacing="8" VBox.vgrow="ALWAYS">
        
        <Button text="📊 Main Page Dashboard" maxWidth="Infinity" 
                onAction="#navigateToMainPage"
                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 16; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
        
        <Button text="📦 Gestion des Produits" maxWidth="Infinity"
                onAction="#navigateToGestionProduits"
                style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-padding: 12 16; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
        
        <Button text="📋 Gestion du Stock" maxWidth="Infinity"
                onAction="#navigateToGestionStock"
                style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-padding: 12 16; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
        
        <Button text="🔔 Recevoir des Alertes" maxWidth="Infinity"
                onAction="#navigateToRecevoirAlertes"
                style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-padding: 12 16; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
        
        <Button text="🛒 Gestion des Commandes" maxWidth="Infinity"
                onAction="#navigateToConsulterCommandes"
                style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-padding: 12 16; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
        
        <Button text="👤 Profil Magasinier" maxWidth="Infinity"
                onAction="#navigateToProfilMagasinier"
                style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-padding: 12 16; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
        
        <!-- Spacer -->
        <Region VBox.vgrow="ALWAYS" />
        
        <Separator style="-fx-background-color: #e5e7eb;" />
        
        <Button text="🚪 Déconnexion" maxWidth="Infinity"
                onAction="#handleLogout"
                style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-background-radius: 8; -fx-padding: 12 16; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-font-weight: 600;" />
      </VBox>
    </VBox>
  </left>
  
  <!-- CONTENU PRINCIPAL (zone qui change selon le menu) -->
  <center>
    <VBox spacing="0">
      <!-- Top bar avec bouton toggle sidebar -->
      <HBox spacing="10" style="-fx-background-color: white; -fx-padding: 10 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
        <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
        <Label text="Dashboard Magasinier" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #374151;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="sidebarToggleBtn" text="⟨" onAction="#toggleSidebar" 
                style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-size: 16px; -fx-padding: 8 12; -fx-background-radius: 6; -fx-cursor: hand;" />
      </HBox>
      
      <!-- Zone de contenu dynamique -->
      <StackPane fx:id="contentRoot" VBox.vgrow="ALWAYS" style="-fx-background-color: #EAEEF4;">
        <!-- Le contenu sera chargé dynamiquement -->
        <Label text="Chargement..." style="-fx-font-size: 16px; -fx-text-fill: #6b7280;" />
      </StackPane>
    </VBox>
  </center>
  
</BorderPane>