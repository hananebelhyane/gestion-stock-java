<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gestiondestock.controller.ViewController">
  <children>
    <VBox alignment="CENTER" spacing="16">
      <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
      <Label text="Welcome" fx:id="WelcomeLabel" style="-fx-font-size: 28; -fx-font-weight: bold;"/>
      <Label text="This is a simple welcome page." style="-fx-font-size: 14; -fx-text-fill: #555;"/>
    </VBox>
  </children>
</StackPane>