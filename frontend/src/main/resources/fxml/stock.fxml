<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gestiondestock.controller.StockController"
      styleClass="root-container"
      stylesheets="@/styles/StockStyles.css"
      spacing="0">

    <!-- HEADER -->
    <VBox styleClass="page-header">
        <Label text="Gestion des Stocks" styleClass="main-title">
            <font><Font name="System Bold" size="32"/></font>
        </Label>
        <Label text="Gérez votre inventaire de produits" styleClass="subtitle">
            <font><Font size="14"/></font>
        </Label>
        <VBox.margin>
            <Insets top="40" bottom="30" left="40" right="40"/>
        </VBox.margin>
    </VBox>

    <!-- CARD -->
    <VBox styleClass="content-card" VBox.vgrow="ALWAYS">

        <!-- Toolbar -->
        <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="15">

            <!-- Search -->
            <HBox styleClass="search-container" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label text="🔍" styleClass="search-icon">
                    <font><Font size="16"/></font>
                </Label>
                <TextField fx:id="txtSearch" promptText="Rechercher un produit..."
                           styleClass="search-input" HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Rechercher -->
            <Button fx:id="btnRechercher" text="Rechercher"
                    onAction="#handleRechercher" styleClass="btn-secondary"/>

            <!-- Rafraîchir -->
            <Button fx:id="btnRafraichir" text="🔄 Rafraîchir"
                    onAction="#rafraichir" styleClass="btn-secondary"/>

            <!-- Ajouter Stock -->
            <Button fx:id="btnAjouter" onAction="#handleAjouter" styleClass="btn-add">
                <graphic>
                    <HBox alignment="CENTER" spacing="8">
                        <Label text="+" styleClass="plus-icon">
                            <font><Font size="18"/></font>
                        </Label>
                        <Label text="Ajouter Stock" styleClass="btn-text">
                            <font><Font size="13"/></font>
                        </Label>
                    </HBox>
                </graphic>
            </Button>

            <!-- Export -->
            <Button fx:id="btnExporter" onAction="#handleExporter" styleClass="btn-export">
                <graphic>
                    <HBox alignment="CENTER" spacing="8">
                        <Label text="📄" styleClass="icon-export"/>
                        <Label text="Exporter" styleClass="btn-text">
                            <font><Font size="13"/></font>
                        </Label>
                    </HBox>
                </graphic>
            </Button>
        </HBox>

        <!-- Table -->
        <TableView fx:id="tableStock" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="120" />
                <TableColumn fx:id="colProduit" text="Produit" prefWidth="200" />
                <TableColumn fx:id="colQte" text="Quantité" prefWidth="120" />
                <TableColumn fx:id="colPrix" text="Prix" prefWidth="120" />
                <TableColumn fx:id="colActions" text="Actions" prefWidth="150" />
            </columns>
        </TableView>

        <VBox.margin>
            <Insets top="0" bottom="40" left="40" right="40"/>
        </VBox.margin>
    </VBox>

</VBox>