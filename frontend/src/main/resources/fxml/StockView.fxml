<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<VBox xmlns="http://javafx.com/javafx/8" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gestiondestock.controller.StockController"
      alignment="TOP_LEFT"
      spacing="20">
      
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>


    <!-- Titre -->
    <VBox spacing="2">
        <Label text="Gestion de stock" styleClass="page-title"/>
    </VBox>

    <!-- CARD PRINCIPALE -->
    <VBox spacing="15" styleClass="card">

        <!-- Ligne de recherche + bouton ajouter + exporter -->
        <HBox spacing="10" alignment="CENTER_LEFT">

            <TextField fx:id="searchField"
                       promptText="Rechercher un produit par nom..."
                       styleClass="search-input"
                       HBox.hgrow="ALWAYS"/>

            <Button fx:id="addButton"
                    text="+ Ajouter Stock"
                    styleClass="btn-primary"/>

            <Button fx:id="exportButton"
                    text="⎘ Exporter"
                    onAction="#onExport"
                    styleClass="btn-secondary"/>
        </HBox>

<TableView fx:id="tableView" styleClass="modern-table">
    <columns>

        <TableColumn fx:id="produitCol"
                     text="Produit"
                     prefWidth="200"/>

        <TableColumn fx:id="quantiteCol"
                     text="Quantité Disponible"
                     prefWidth="150"/>

        <TableColumn fx:id="seuilCol"
                     text="Seuil d'Alerte"
                     prefWidth="150"/>

        <TableColumn fx:id="actionCol"
                     text="Actions"
                     prefWidth="120"/>

    </columns>
</TableView>

    </VBox>
</VBox>
