<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gestiondestock.controller.EditProduitController"
      spacing="15" style="-fx-background-color: white; -fx-padding: 20;">
  <Label text="Modifier le Produit" styleClass="page-title"/>
  <VBox spacing="10" styleClass="card">
    <VBox spacing="5">
      <Label text="Nom du produit:"/>
      <TextField fx:id="nomField"/>
    </VBox>
    <VBox spacing="5">
      <Label text="Prix (DH):"/>
      <TextField fx:id="prixField"/>
    </VBox>
    <VBox spacing="5">
      <Label text="Catégorie:"/>
      <ComboBox fx:id="categorieCombo"/>
    </VBox>
    <VBox spacing="5">
      <Label text="Fournisseur:"/>
      <ComboBox fx:id="fournisseurCombo"/>
    </VBox>
    <VBox spacing="5">
      <Label text="Description:"/>
      <TextArea fx:id="descriptionArea" prefRowCount="3"/>
    </VBox>
    <HBox spacing="10" alignment="CENTER_RIGHT">
      <Button text="Annuler" onAction="#handleCancel" style="-fx-background-color: black; -fx-text-fill: white;"/>
      <Button text="Supprimer" onAction="#handleDelete" style="-fx-background-color: black; -fx-text-fill: white;"/>
      <Button text="Enregistrer" onAction="#handleUpdateProduit" style="-fx-background-color: black; -fx-text-fill: white;"/>
    </HBox>
  </VBox>
</VBox>
