<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gestiondestock.controller.ViewGestionDeCommande">
   <children>
      
      <!-- En-tête avec titre principal -->
      <Label layoutX="50.0" layoutY="30.0" text="Gestion des Commandes" textFill="#000000">
         <font>
            <Font name="System Bold" size="28.0" />
         </font>
      </Label>
      
      <!-- Sous-titre -->
      <Label layoutX="50.0" layoutY="65.0" text="Gérez vos commandes clients et fournisseurs" textFill="#7f8c8d">
         <font>
            <Font size="13.0" />
         </font>
      </Label>
      
      <!-- RadioButtons avec style moderne -->
      <RadioButton fx:id="rButton1" layoutX="50.0" layoutY="110.0" mnemonicParsing="false" onAction="#getCommande" text="Client Commande" style="-fx-font-size: 14px; -fx-text-fill: #000000;">
         <toggleGroup>
            <ToggleGroup fx:id="commandeGroup" />
         </toggleGroup>
      </RadioButton>
      
      <RadioButton fx:id="rButton2" layoutX="220.0" layoutY="110.0" mnemonicParsing="false" onAction="#getCommande" text="Fournisseur commande" toggleGroup="$commandeGroup" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
      
      <!-- Barre de recherche -->
      <TextField fx:id="searchField" layoutX="50.0" layoutY="150.0" prefHeight="35.0" prefWidth="250.0" promptText="Rechercher une commande..." style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 5 10 5 10; -fx-font-size: 13px;" onKeyReleased="#handleSearch" disable="true" />
      
      <!-- Boutons d'action avec style noir -->
      <Button fx:id="btnRechercher" layoutX="310.0" layoutY="150.0" mnemonicParsing="false" onAction="#handleRechercher" prefHeight="35.0" prefWidth="100.0" text="Rechercher" style="-fx-background-color: #000000; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 5; -fx-cursor: hand;" disable="true" />
      
      <Button fx:id="btnRefresh" layoutX="420.0" layoutY="150.0" mnemonicParsing="false" onAction="#handleRefresh" prefHeight="35.0" prefWidth="100.0" text="⟳ Rafraîchir" style="-fx-background-color: #000000; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 5; -fx-cursor: hand;" disable="true" />
      
      <Button fx:id="btnAjouter" layoutX="530.0" layoutY="150.0" mnemonicParsing="false" onAction="#handleAjouter" prefHeight="35.0" prefWidth="120.0" text="+ Ajouter" style="-fx-background-color: #000000; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 5; -fx-cursor: hand;" disable="true" />
      
      <!-- TableView avec style moderne -->
      <TableView fx:id="commandeTable" layoutX="50.0" layoutY="200.0" prefHeight="360.0" prefWidth="700.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-radius: 5;">
        <columns>
          <TableColumn fx:id="colId" prefWidth="120.0" text="ID" style="-fx-alignment: CENTER-LEFT; -fx-font-weight: bold;" />
          <TableColumn fx:id="colDate" prefWidth="120.0" text="Date Commande" style="-fx-alignment: CENTER;" />
          <TableColumn fx:id="colStatut" prefWidth="100.0" text="Statut" style="-fx-alignment: CENTER;" />
          <TableColumn fx:id="colMontant" prefWidth="100.0" text="Seuil Max" style="-fx-alignment: CENTER;" />
          <TableColumn fx:id="colClient" prefWidth="150.0" text="Client" style="-fx-alignment: CENTER-LEFT;" />
          <TableColumn fx:id="colAction" prefWidth="110.0" text="Action" style="-fx-alignment: CENTER;" />
        </columns>
      </TableView>
      
   </children>
</AnchorPane>