<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root" style="-fx-background-color: #F9FAFB;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gestiondestock.controller.ClientDashboardController">
  <left>
    <VBox fx:id="sidebar" prefWidth="250" spacing="20" style="-fx-background-color: white; -fx-padding: 25; -fx-border-color: #E5E7EB; -fx-border-width: 0 1 0 0;">
      <children>
        <ImageView fx:id="logoImage" fitWidth="140" preserveRatio="true"/>
        <VBox spacing="10" VBox.vgrow="ALWAYS">
          <children>
            <Button maxWidth="Infinity" onAction="#loadAllProducts" style="-fx-background-color: #F3F4F6; -fx-text-fill: #111827; -fx-alignment: CENTER_LEFT; -fx-padding: 12; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;" text="📦 Liste des produits"/>
            <Button maxWidth="Infinity" onAction="#showCart" style="-fx-background-color: transparent; -fx-text-fill: #4B5563; -fx-alignment: CENTER_LEFT; -fx-padding: 12; -fx-cursor: hand;" text="🛒 Mon Panier"/>
          </children>
        </VBox>
        <Separator/>
        <MenuButton maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-padding: 8; -fx-cursor: hand;" text="👤 Mon Profil">
          <items>
            <MenuItem onAction="#navigateToProfile" text="Consulter Profil"/>
            <SeparatorMenuItem/>
            <MenuItem onAction="#handleLogout" style="-fx-text-fill: #EF4444;" text="Déconnexion"/>
          </items>
        </MenuButton>
      </children>
    </VBox>
  </left>

  <center>
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F9FAFB;">
      <content>
        <VBox spacing="25" style="-fx-padding: 30;">
          <children>
            <HBox alignment="CENTER_LEFT">
              <children>
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Catalogue"/>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane>
                  <children>
                    <Button onAction="#showCart" style="-fx-background-color: #000000; -fx-text-fill: white; -fx-padding: 10 15; -fx-background-radius: 10; -fx-font-size: 18px; -fx-cursor: hand;" text="🛒"/>
                    <Label fx:id="cartBadge" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-size: 11px; -fx-padding: 2 6; -fx-background-radius: 10;" text="0" StackPane.alignment="TOP_RIGHT">
                      <StackPane.margin>
                        <Insets right="-5" top="-5"/>
                      </StackPane.margin>
                    </Label>
                  </children>
                </StackPane>
              </children>
            </HBox>
            <VBox spacing="10">
              <children>
                <Label style="-fx-text-fill: #6B7280; -fx-font-weight: bold;" text="Filtrer par catégorie"/>
                <HBox fx:id="categoryFilterContainer" spacing="10"/>
              </children>
            </VBox>
            <FlowPane fx:id="productGrid" hgap="20" vgap="20"/>
          </children>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
