<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
			fx:controller="gestiondestock.controller.ClientDashboardController"
			fx:id="root"
			style="-fx-background-color: #EAEEF4;">

	<left>
		<VBox spacing="16" fx:id="sidebar"
			  prefWidth="230" minWidth="190"
			  style="-fx-background-color: white; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
			<padding><Insets top="20" right="16" bottom="20" left="20"/></padding>

			<HBox spacing="8" alignment="CENTER_LEFT">
				<ImageView fx:id="logoImage" fitWidth="120" preserveRatio="true" smooth="true" />
			</HBox>

			<Separator />

			<Label text="Espace Client" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;" />

			<VBox spacing="8" VBox.vgrow="ALWAYS">
				<Button text="🏠 Accueil"
						maxWidth="Infinity"
						style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
				<Button text="🛒 Voir le panier" onAction="#showCart"
						maxWidth="Infinity"
						style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
				<Button text="🧾 Voir facture" onAction="#showLastFacture"
						maxWidth="Infinity"
						style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
			    <Button text="👤 Profil" onAction="#navigateToProfile"
				    maxWidth="Infinity"
				    style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
				<Region VBox.vgrow="ALWAYS" />

				<Separator />
				<Button text="🚪 Déconnexion" onAction="#handleLogout"
						maxWidth="Infinity"
						style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-font-weight: 600;" />
			</VBox>
		</VBox>
	</left>

	<center>
		<VBox spacing="0">
			<HBox spacing="10" alignment="CENTER_LEFT"
				  style="-fx-background-color: white; -fx-padding: 12 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);">
				<Label text="Catalogue" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
				<Region HBox.hgrow="ALWAYS" />

				<HBox spacing="6" alignment="CENTER_LEFT">
					<Button fx:id="sidebarToggleBtn" text="⟨" onAction="#toggleSidebar"
							style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-size: 14px; -fx-padding: 8 10; -fx-background-radius: 6; -fx-cursor: hand;" />

					<StackPane>
						<Button text="🛒" onAction="#showCart"
								style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-padding: 8 12; -fx-background-radius: 8; -fx-font-size: 16px; -fx-cursor: hand;" />
						<Label fx:id="cartBadge" text="0"
							   style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 11px; -fx-padding: 2 6; -fx-background-radius: 999;"
							   StackPane.alignment="TOP_RIGHT">
							<StackPane.margin>
								<Insets top="-6.0" right="-6.0" bottom="0.0" left="0.0" />
							</StackPane.margin>
						</Label>
					</StackPane>
				</HBox>
			</HBox>

			<VBox spacing="12">
				<padding>
					<Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
				</padding>
				<HBox spacing="12" alignment="CENTER_LEFT">
					<Label text="Catégorie" style="-fx-text-fill: #4b5563;" />
					<ComboBox fx:id="categoryFilter" promptText="Toutes les catégories" prefWidth="220"
							  onAction="#onCategoryChanged" />
				</HBox>

				<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
					<FlowPane fx:id="productGrid" hgap="12" vgap="12" prefWidth="800">
						<padding>
							<Insets top="12.0" right="12.0" bottom="12.0" left="12.0" />
						</padding>
					</FlowPane>
				</ScrollPane>
			</VBox>
		</VBox>
	</center>

</BorderPane>
